        {
          "name": "01 Register - New Patient (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.{{$timestamp}}@example.com\",\n  \"password\": \"Patient@123\",\n  \"name\": \"Postman Patient\",\n  \"age\": 30,\n  \"gender\": \"Female\",\n  \"phone\": \"+91 90000 00000\",\n  \"bloodGroup\": \"O+\",\n  \"address\": \"12 Rosewood Lane, Bengaluru 560025\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "201. Unique email via $timestamp. Saves patientToken+patientId."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201',()=>pm.response.to.have.status(201));",
                  "const j=pm.response.json();",
                  "pm.test('has token',()=>pm.expect(j).to.have.property('token'));",
                  "pm.collectionVariables.set('patientToken',j.token);",
                  "pm.collectionVariables.set('patientId',j.user.profileId);"
                ]
              }
            }
          ]
        },
