# Environment variables for Backend
# Local development values only — Railway provides the real values via its
# Variables panel (MONGODB_URI, JWT_SECRET, plus optional PORT override and
# CORS_ALLOWED_ORIGINS). Never commit real credentials.
MONGODB_URI=mongodb://localhost:27017/aldergate
JWT_SECRET=your-32-character-secret-key-here
# Comma-separated browser origins allowed to call the API (Spring CORS).
# While the Vite UI runs locally against the Railway backend, keep this as:
# CORS_ALLOWED_ORIGINS=http://localhost:5173
# PORT is injected by Railway; 8080 is only the local default.
# PORT=8080
