# Local Vite → Railway backend wiring.
# Point local `npm run dev` at the deployed Spring Boot backend:
#   VITE_API_URL=https://<RAILWAY-BACKEND-DOMAIN>
# When unset/empty, API calls stay relative ("/api/...") and the Vite dev
# proxy in vite.config.js forwards them to http://localhost:8080.
VITE_API_URL=
